<Application x:Class="LR_1_Toolkit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LR_1_Toolkit.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CustomStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:GreaterThanOrEqualConverter x:Key="GreaterThanOrEqualConverter"/>
            <converters:LessThanOrEqualConverter x:Key="LessThanOrEqualConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>