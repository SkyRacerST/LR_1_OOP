<UserControl x:Class="LR_1_Default.Views.DefaultBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LR_1_Default.MarkupExtensions"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20">
                <TextBlock.Text>
                    <loc:LocExtension Key="DefaultBindingTitle"/>
                </TextBlock.Text>
            </TextBlock>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="16" Margin="0,0,0,10">
                        <TextBlock.Text>
                            <loc:LocExtension Key="WhatIsDefaultBinding"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        <TextBlock.Text>
                            <loc:LocExtension Key="DefaultBindingDescription"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label>
                        <Label.Content>
                            <loc:LocExtension Key="DirectBindingToViewModel"/>
                        </Label.Content>
                    </Label>

                    <TextBlock FontWeight="SemiBold" Margin="0,5,0,0">
                        <TextBlock.Text>
                            <loc:LocExtension Key="TextBoxWithDefaultBinding"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBox Text="{Binding UserInput, UpdateSourceTrigger=LostFocus}" Height="35"/>
                    <TextBlock FontStyle="Italic" Foreground="Gray" Margin="5,0,0,0">
                        <TextBlock.Text>
                            <loc:LocExtension Key="ValueUpdatesOnLostFocus"/>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock FontWeight="SemiBold" Margin="0,15,0,0">
                        <TextBlock.Text>
                            <loc:LocExtension Key="DisplayedText"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBox Text="{Binding UserInput, Mode=OneWay}" Height="35" IsReadOnly="True" Background="#F0F0F0"/>

                    <Separator Margin="0,15,0,15"/>

                    <Label>
                        <Label.Content>
                            <loc:LocExtension Key="SliderWithDefaultBinding"/>
                        </Label.Content>
                    </Label>
                    <Slider Minimum="0" Maximum="100" Value="{Binding SliderValue}" Height="30" Margin="5"/>
                    <TextBlock Text="{Binding SliderValueDisplay}" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Label>
                        <Label.Content>
                            <loc:LocExtension Key="ElementToElementBindingExample"/>
                        </Label.Content>
                    </Label>
                    <TextBlock FontWeight="SemiBold">
                        <TextBlock.Text>
                            <loc:LocExtension Key="SourceTextBox"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBox x:Name="SourceTextBox" Height="35"/>
                    <TextBlock FontWeight="SemiBold" Margin="0,10,0,0">
                        <TextBlock.Text>
                            <loc:LocExtension Key="TargetTextBlock"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding Text, ElementName=SourceTextBox}" Background="#F0F0F0" Padding="8" Margin="5"/>
                    <TextBlock FontStyle="Italic" Foreground="Gray" Margin="5,5,0,0">
                        <TextBlock.Text>
                            <loc:LocExtension Key="ElementToElementBindingDescription"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>