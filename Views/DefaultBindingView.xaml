<UserControl x:Class="LR_1_Default.Views.DefaultBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="{DynamicResource DefaultBindingTitle}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{DynamicResource WhatIsDefaultBinding}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource DefaultBindingDescription}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="{DynamicResource DirectBindingToViewModel}"/>

                    <TextBlock Text="{DynamicResource TextBoxWithDefaultBinding}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBox Text="{Binding UserInput, UpdateSourceTrigger=LostFocus}" Height="35"/>
                    <TextBlock Text="{DynamicResource ValueUpdatesOnLostFocus}" FontStyle="Italic" Foreground="Gray" Margin="5,0,0,0"/>

                    <TextBlock Text="{DynamicResource DisplayedText}" FontWeight="SemiBold" Margin="0,15,0,0"/>
                    <TextBox Text="{Binding UserInput, Mode=OneWay}" Height="35" IsReadOnly="True" Background="#F0F0F0"/>

                    <Separator Margin="0,15,0,15"/>

                    <Label Content="{DynamicResource SliderWithDefaultBinding}"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding SliderValue}" Height="30" Margin="5"/>
                    <TextBlock Text="{Binding SliderValueDisplay}" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Label Content="{DynamicResource ElementToElementBindingExample}"/>
                    <TextBlock Text="{DynamicResource SourceTextBox}" FontWeight="SemiBold"/>
                    <TextBox x:Name="SourceTextBox" Height="35"/>
                    <TextBlock Text="{DynamicResource TargetTextBlock}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Text, ElementName=SourceTextBox}" Background="#F0F0F0" Padding="8" Margin="5"/>
                    <TextBlock Text="{DynamicResource ElementToElementBindingDescription}" FontStyle="Italic" Foreground="Gray" Margin="5,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>