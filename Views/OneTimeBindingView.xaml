<UserControl x:Class="LR_1_Default.Views.OneTimeBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="{DynamicResource OneTimeBindingTitle}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{DynamicResource WhatIsOneTimeBinding}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource OneTimeBindingDescription}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="{DynamicResource StaticInformation}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource WelcomeMessageLabel}" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="5"/>
                        <TextBlock Text="{Binding WelcomeMessage, Mode=OneTime}" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="5"/>

                        <TextBlock Text="{DynamicResource ApplicationTitleLabel}" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="5,10,5,5"/>
                        <TextBlock Text="{Binding ApplicationTitle, Mode=OneTime}" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="5,10,5,5"/>

                        <TextBlock Text="{DynamicResource LoadTime}" Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="5,10,5,5"/>
                        <TextBlock Text="{Binding LoadTime, Mode=OneTime}" Grid.Row="2" Grid.Column="1" Margin="5,10,5,5"/>

                        <TextBlock Text="{DynamicResource Version}" Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Margin="5,10,5,5"/>
                        <TextBlock Text="{Binding Version, Mode=OneTime}" Grid.Row="3" Grid.Column="1" Margin="5,10,5,5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Label Content="{DynamicResource Description}"/>
                    <Border Background="#F0F0F0" Padding="10" CornerRadius="5">
                        <TextBlock Text="{Binding Description, Mode=OneTime}" TextWrapping="Wrap" MinHeight="100"/>
                    </Border>
                    <TextBlock Text="{DynamicResource OneTimeBindingNote}" Foreground="#E67E22" Margin="5,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>