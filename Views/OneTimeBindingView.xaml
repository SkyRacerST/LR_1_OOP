<UserControl x:Class="LR_1_Default.Views.OneTimeBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Демонстрация однократной привязки" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Что такое однократная привязка?" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Однократная привязка устанавливает свойство цели один раз из источника при инициализации. Последующие изменения источника НЕ влияют на цель. Идеально подходит для статического контента, такого как заголовки, метки и данные конфигурации." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="Статическая информация (устанавливается один раз при загрузке)"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Приветственное сообщение:" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="5"/>
                        <TextBlock Text="{Binding WelcomeMessage, Mode=OneTime}" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="5"/>

                        <TextBlock Text="Название приложения:" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="5,10,5,5"/>
                        <TextBlock Text="{Binding ApplicationTitle, Mode=OneTime}" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="5,10,5,5"/>

                        <TextBlock Text="Время загрузки:" Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="5,10,5,5"/>
                        <TextBlock Text="{Binding LoadTime, Mode=OneTime}" Grid.Row="2" Grid.Column="1" Margin="5,10,5,5"/>

                        <TextBlock Text="Версия:" Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Margin="5,10,5,5"/>
                        <TextBlock Text="{Binding Version, Mode=OneTime}" Grid.Row="3" Grid.Column="1" Margin="5,10,5,5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Label Content="Описание"/>
                    <Border Background="#F0F0F0" Padding="10" CornerRadius="5">
                        <TextBlock Text="{Binding Description, Mode=OneTime}" TextWrapping="Wrap" MinHeight="100"/>
                    </Border>
                    <TextBlock Text="⚠️ Примечание: Этот контент был установлен один раз при запуске приложения и не может быть изменен динамически." Foreground="#E67E22" Margin="5,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>