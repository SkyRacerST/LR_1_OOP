<UserControl x:Class="LR_1_Default.Views.OneTimeBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LR_1_Default.MarkupExtensions"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20">
                <TextBlock.Text>
                    <loc:LibraryLocExtension Key="OneTimeBindingTitle"/>
                </TextBlock.Text>
            </TextBlock>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="16" Margin="0,0,0,10">
                        <TextBlock.Text>
                            <loc:LibraryLocExtension Key="WhatIsOneTimeBinding"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap">
                        <TextBlock.Text>
                            <loc:LibraryLocExtension Key="OneTimeBindingDescription"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label>
                        <Label.Content>
                            <loc:LibraryLocExtension Key="StaticInformation"/>
                        </Label.Content>
                    </Label>

                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="5">
                            <TextBlock.Text>
                                <loc:LibraryLocExtension Key="WelcomeMessageLabel"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding WelcomeMessage, Mode=OneTime}" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="5,10,5,5">
                            <TextBlock.Text>
                                <loc:LibraryLocExtension Key="ApplicationTitleLabel"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding ApplicationTitle, Mode=OneTime}" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="5,10,5,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="5,10,5,5">
                            <TextBlock.Text>
                                <loc:LibraryLocExtension Key="LoadTime"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding LoadTime, Mode=OneTime}" Grid.Row="2" Grid.Column="1" Margin="5,10,5,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Margin="5,10,5,5">
                            <TextBlock.Text>
                                <loc:LibraryLocExtension Key="Version"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding Version, Mode=OneTime}" Grid.Row="3" Grid.Column="1" Margin="5,10,5,5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Label>
                        <Label.Content>
                            <loc:LibraryLocExtension Key="Description"/>
                        </Label.Content>
                    </Label>
                    <Border Background="#F0F0F0" Padding="10" CornerRadius="5">
                        <TextBlock Text="{Binding Description, Mode=OneTime}" TextWrapping="Wrap" MinHeight="100"/>
                    </Border>
                    <TextBlock Foreground="#E67E22" Margin="5,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <loc:LibraryLocExtension Key="OneTimeBindingNote"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>