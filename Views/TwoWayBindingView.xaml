<UserControl x:Class="LR_1_Default.Views.TwoWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="{DynamicResource TwoWayBindingTitle}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{DynamicResource WhatIsTwoWayBinding}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource TwoWayBindingDescription}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="{DynamicResource UserInformation}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource FirstName}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Height="35" Margin="5,0,0,0"/>

                        <TextBlock Text="{DynamicResource LastName}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Height="35" Margin="5,10,0,0"/>

                        <TextBlock Text="{DynamicResource FullName}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding FullName}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="5,10,0,0" FontSize="16" FontWeight="Bold" Foreground="#3498DB"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource FullNameAutoUpdate}" FontStyle="Italic" Foreground="Gray" Margin="5,15,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="{DynamicResource CheckBoxBinding}"/>
                    <CheckBox Content="{DynamicResource EnableFeature}" IsChecked="{Binding IsChecked}" Margin="5"/>
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Margin="5,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Label Content="{DynamicResource SliderBinding}"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="30"/>
                    <TextBlock Text="{Binding ProgressDisplay}" HorizontalAlignment="Center" FontWeight="Bold" Margin="5"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>