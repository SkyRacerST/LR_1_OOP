<UserControl x:Class="LR_1_Toolkit.Views.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Демонстрация однонаправленной привязки" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Что такое однонаправленная привязка?" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Однонаправленная привязка обновляет цель при изменении источника, но изменения цели НЕ обновляют источник. Полезно для отображения производных данных, доступных только для чтения." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="Исходные данные (редактируемые)"/>
                    <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="5"/>
                    <TextBlock Text="Изменения источника влияют на отображение ниже:" FontStyle="Italic" Foreground="Gray" Margin="5,0,0,5"/>

                    <Label Content="Обработанный вывод (только для чтения - однонаправленная привязка)" Margin="0,15,0,0"/>
                    <Border Background="#F0F0F0" Padding="10" CornerRadius="5" Margin="5">
                        <TextBlock Text="{Binding ProcessedText}" TextWrapping="Wrap" MinHeight="50"/>
                    </Border>

                    <TextBlock Text="Обработанный текст формируется из источника и обновляется автоматически, но не может быть отредактирован напрямую." FontStyle="Italic" Foreground="Gray" Margin="5,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="Пример счетчика"/>
                    <TextBlock Text="{Binding CounterDisplay}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="5" Foreground="#2C3E50"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Увеличить" Width="100" Height="35" Command="{Binding IncrementCommand}"/>
                        <Button Content="Сбросить" Width="100" Height="35" Command="{Binding ResetCommand}"/>
                    </StackPanel>
                    <TextBlock Text="Значение счетчика хранится в ViewModel и отображается с однонаправленной привязкой. Используются RelayCommand из Toolkit." FontStyle="Italic" Foreground="Gray" HorizontalAlignment="Center" Margin="5,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Label Content="Пример ползунка"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding SliderValue}" Height="30"/>
                    <TextBlock Text="{Binding SliderDisplay}" HorizontalAlignment="Center" FontWeight="Bold" Margin="5" FontSize="14"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>