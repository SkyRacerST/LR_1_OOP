<UserControl x:Class="LR_1_Default.Views.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LR_1_Default.MarkupExtensions"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20">
                <TextBlock.Text>
                    <loc:LocExtension Key="OneWayBindingTitle"/>
                </TextBlock.Text>
            </TextBlock>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="16" Margin="0,0,0,10">
                        <TextBlock.Text>
                            <loc:LocExtension Key="WhatIsOneWayBinding"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap">
                        <TextBlock.Text>
                            <loc:LocExtension Key="OneWayBindingDescription"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label>
                        <Label.Content>
                            <loc:LocExtension Key="SourceDataEditable"/>
                        </Label.Content>
                    </Label>
                    <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="5"/>
                    <TextBlock FontStyle="Italic" Foreground="Gray" Margin="5,0,0,5">
                        <TextBlock.Text>
                            <loc:LocExtension Key="SourceChangesAffectDisplay"/>
                        </TextBlock.Text>
                    </TextBlock>

                    <Label Margin="0,15,0,0">
                        <Label.Content>
                            <loc:LocExtension Key="ProcessedOutputReadOnly"/>
                        </Label.Content>
                    </Label>
                    <Border Background="#F0F0F0" Padding="10" CornerRadius="5" Margin="5">
                        <TextBlock Text="{Binding ProcessedText}" TextWrapping="Wrap" MinHeight="50"/>
                    </Border>

                    <TextBlock FontStyle="Italic" Foreground="Gray" Margin="5,10,0,0">
                        <TextBlock.Text>
                            <loc:LocExtension Key="ProcessedTextDescription"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label>
                        <Label.Content>
                            <loc:LocExtension Key="CounterExample"/>
                        </Label.Content>
                    </Label>
                    <TextBlock Text="{Binding CounterDisplay}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="5" Foreground="#2C3E50"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Width="100" Height="35" Click="Increment_Click">
                            <Button.Content>
                                <loc:LocExtension Key="Increment"/>
                            </Button.Content>
                        </Button>
                        <Button Width="100" Height="35" Click="Reset_Click">
                            <Button.Content>
                                <loc:LocExtension Key="Reset"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                    <TextBlock FontStyle="Italic" Foreground="Gray" HorizontalAlignment="Center" Margin="5,10,0,0">
                        <TextBlock.Text>
                            <loc:LocExtension Key="CounterDescription"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Label>
                        <Label.Content>
                            <loc:LocExtension Key="SliderExample"/>
                        </Label.Content>
                    </Label>
                    <Slider Minimum="0" Maximum="100" Value="{Binding SliderValue}" Height="30"/>
                    <TextBlock Text="{Binding SliderDisplay}" HorizontalAlignment="Center" FontWeight="Bold" Margin="5" FontSize="14"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>