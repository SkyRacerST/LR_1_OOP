<UserControl x:Class="LR_1_Default.Views.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="{DynamicResource OneWayBindingTitle}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{DynamicResource WhatIsOneWayBinding}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource OneWayBindingDescription}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="{DynamicResource SourceDataEditable}"/>
                    <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="5"/>
                    <TextBlock Text="{DynamicResource SourceChangesAffectDisplay}" FontStyle="Italic" Foreground="Gray" Margin="5,0,0,5"/>

                    <Label Content="{DynamicResource ProcessedOutputReadOnly}" Margin="0,15,0,0"/>
                    <Border Background="#F0F0F0" Padding="10" CornerRadius="5" Margin="5">
                        <TextBlock Text="{Binding ProcessedText}" TextWrapping="Wrap" MinHeight="50"/>
                    </Border>

                    <TextBlock Text="{DynamicResource ProcessedTextDescription}" FontStyle="Italic" Foreground="Gray" Margin="5,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="{DynamicResource CounterExample}"/>
                    <TextBlock Text="{Binding CounterDisplay}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="5" Foreground="#2C3E50"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="{DynamicResource Increment}" Width="100" Height="35" Click="Increment_Click"/>
                        <Button Content="{DynamicResource Reset}" Width="100" Height="35" Click="Reset_Click"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource CounterDescription}" FontStyle="Italic" Foreground="Gray" HorizontalAlignment="Center" Margin="5,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Label Content="{DynamicResource SliderExample}"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding SliderValue}" Height="30"/>
                    <TextBlock Text="{Binding SliderDisplay}" HorizontalAlignment="Center" FontWeight="Bold" Margin="5" FontSize="14"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>