<UserControl x:Class="LR_1_Default.Views.TriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Демонстрация триггеров" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

            <!-- Property Triggers -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Property Триггеры" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Property триггеры применяют стили, когда свойство элемента управления достигает определенного значения." TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <CheckBox Content="Включить кнопку" IsChecked="{Binding IsEnabled}" Margin="5"/>
                    <Button Content="{Binding ButtonText}" Width="150" Height="35" Margin="5" IsEnabled="{Binding IsEnabled}"/>
                </StackPanel>
            </Border>

            <!-- Data Triggers -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Data Триггеры" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Data триггеры реагируют на изменения значений в ViewModel." TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <CheckBox Content="Показать текст" IsChecked="{Binding IsVisible}" Margin="5"/>
                    <Border Background="#E8F8F5" Padding="10" CornerRadius="5" Margin="5">
                        <TextBlock Text="Этот текст виден, когда флажок установлен">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- MultiDataTrigger -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="MultiDataTrigger" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="MultiDataTrigger применяет стили, когда выполняются несколько условий одновременно." TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="5">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#BDC3C7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <!-- Пустой ввод -->
                                    <DataTrigger Binding="{Binding InputText.Length}" Value="0">
                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#FDEDEC"/>
                                        <Setter Property="ToolTip" Value="Поле не может быть пустым"/>
                                    </DataTrigger>
                                    <!-- Короткий ввод (1-2 символа) -->
                                    <DataTrigger Binding="{Binding InputText.Length}" Value="1">
                                        <Setter Property="BorderBrush" Value="#F39C12"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="ToolTip" Value="Минимум 3 символа"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding InputText.Length}" Value="2">
                                        <Setter Property="BorderBrush" Value="#F39C12"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="ToolTip" Value="Минимум 3 символа"/>
                                    </DataTrigger>
                                    <!-- Длинный ввод (более 20 символов) -->
                                    <DataTrigger Binding="{Binding InputText.Length}" Value="21">
                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="ToolTip" Value="Максимум 20 символов"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding InputText.Length}" Value="22">
                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                    <!-- Корректный ввод (3-20 символов) -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding InputText.Length, Converter={StaticResource GreaterThanOrEqualConverter}}" Value="3"/>
                                            <Condition Binding="{Binding InputText.Length, Converter={StaticResource LessThanOrEqualConverter}}" Value="20"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="#27AE60"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#E8F8F5"/>
                                        <Setter Property="ToolTip" Value="Корректный ввод"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="{Binding ValidationMessage}" FontWeight="SemiBold" Margin="5" FontSize="12"/>
                    <TextBlock Text="Условия: пусто (красный), 1-2 символа (оранжевый), 3-20 символов (зеленый), >20 символов (красный)" FontStyle="Italic" Foreground="Gray" Margin="5,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Event Triggers -->
            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="Event Триггеры" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Event триггеры реагируют на события мыши, такие как наведение и выбор." TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <ListBox ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex}" Height="120" Margin="5">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3498DB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2C3E50"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="{Binding SelectionMessage}" Margin="5" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="Наведите курсор на элементы для отображения триггера MouseOver, нажмите для отображения триггера выбора" FontStyle="Italic" Foreground="Gray" Margin="5,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>