<Window x:Class="LR_1_Default.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LR_1_Default.Views"
        xmlns:viewmodels="clr-namespace:LR_1_Default.ViewModels"
        xmlns:loc="clr-namespace:LR_1_Default.MarkupExtensions"
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Title="{DynamicResource AppTitle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель выбора языка -->
        <Border Grid.Row="0" Background="#34495E" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{DynamicResource LanguageSelection}" 
                           Foreground="White" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"
                           FontSize="14"/>
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          Width="120"
                          Height="30"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="{DynamicResource DefaultBinding}">
                <views:DefaultBindingView DataContext="{Binding DefaultBindingVM}"/>
            </TabItem>
            <TabItem Header="{DynamicResource TwoWayBinding}">
                <views:TwoWayBindingView DataContext="{Binding TwoWayBindingVM}"/>
            </TabItem>
            <TabItem Header="{DynamicResource OneTimeBinding}">
                <views:OneTimeBindingView DataContext="{Binding OneTimeBindingVM}"/>
            </TabItem>
            <TabItem Header="{DynamicResource OneWayBinding}">
                <views:OneWayBindingView DataContext="{Binding OneWayBindingVM}"/>
            </TabItem>
            <TabItem Header="{DynamicResource Triggers}">
                <views:TriggersView DataContext="{Binding TriggersVM}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>