<Window x:Class="LR_1_Default.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LR_1_Default.Views"
        xmlns:viewmodels="clr-namespace:LR_1_Default.ViewModels"
        xmlns:loc="clr-namespace:LR_1_Default.MarkupExtensions"
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Title>
        <loc:LocExtension Key="AppTitle"/>
    </Window.Title>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель выбора языка -->
        <Border Grid.Row="0" Background="#34495E" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Foreground="White" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"
                           FontSize="14">
                    <TextBlock.Text>
                        <loc:LocExtension Key="LanguageSelection"/>
                    </TextBlock.Text>
                </TextBlock>
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          Width="120"
                          Height="30">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem>
                <TabItem.Header>
                    <loc:LocExtension Key="DefaultBinding"/>
                </TabItem.Header>
                <views:DefaultBindingView DataContext="{Binding DefaultBindingVM}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <loc:LocExtension Key="TwoWayBinding"/>
                </TabItem.Header>
                <views:TwoWayBindingView DataContext="{Binding TwoWayBindingVM}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <loc:LocExtension Key="OneTimeBinding"/>
                </TabItem.Header>
                <views:OneTimeBindingView DataContext="{Binding OneTimeBindingVM}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <loc:LocExtension Key="OneWayBinding"/>
                </TabItem.Header>
                <views:OneWayBindingView DataContext="{Binding OneWayBindingVM}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <loc:LocExtension Key="Triggers"/>
                </TabItem.Header>
                <views:TriggersView DataContext="{Binding TriggersVM}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>